{
  "name": "portfolio-os",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host",
    "debug": "NODE_OPTIONS='--inspect-brk' npm run dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write --unsafe .",
    "typecheck": "react-router typegen && tsc --watch",
    "typegen": "wrangler types",
    "build": "react-router build",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "compile": "dotenv -e .env.local graphql-codegen",
    "watch": "dotenv -e .env.local graphql-codegen -w",
    "test": "pnpm playwright test"
  },
  "dependencies": {
    "@react-router/cloudflare": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "classnames": "^2.5.1",
    "graffle": "8.0.0-next.223",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-draggable": "^4.7.1",
    "react-router": "^8.3.0",
    "react-simple-typewriter": "^5.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.1",
    "graphql": "^17.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "wrangler": "^4.119.0"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
